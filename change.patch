 void *(*__dlsym)(void *, const char *) = NULL;
@@ -59,6 +60,40 @@ static void get_real_functions()
     }
 }
 
+static void* func_lookup2(const char* symbol)
+{
+    eh_obj_t libdl;
+    int ret;
+    void *val = NULL;
+
+    const char* libs[] = {
+        "/lib/libc.so.7",
+        "*libc.so*",
+        "*libthr.so*",
+        "*libGL.so*",
+        "*libGLX_nvidia.so*",
+        "*libX11.so*",
+        "*libvulkan*.so*",
+    };
+
+    for (size_t i = 0; i < sizeof(libs) / sizeof(*libs); i++)
+    {
+        ret = eh_find_obj(&libdl, libs[i]);
+        if (ret)
+            continue;
+        // FIXME: HACK, EXPERIMENT!, yay to insecure functions
+        //if (strcmp(symbol, "glVertexAttrib4d") == 0) printf("before disaster\n");
+        eh_find_sym(&libdl, symbol, (void **) &val);
+        // FIXME: HACK, EXPERIMENT!, yay to insecure functions
+        //if (strcmp(symbol, "glVertexAttrib4d") == 0) printf("after disaster, %p\n", val);
+        eh_destroy_obj(&libdl);
+
+        if (val != NULL) return val;
+    }
+
+    return NULL;
+}
+
 /**
  * \brief dlopen() wrapper, just passes calls to real dlopen()
  *        and writes information to standard output
@@ -89,6 +124,10 @@ void *real_dlopen(const char *filename, int flag)
 
     return result;
 }
+static void dummy_func(void) {
+    // This does nothing. It's a stub to prevent MangoHud from crashing
+    // when it demands a GL function that the driver doesn't export.
+}
 
 /**
  * \brief dlsym() wrapper, passes calls to real dlsym() and
@@ -99,12 +138,37 @@ void *real_dlsym(void *handle, const char *symbol)
     if (__dlsym == NULL)
         get_real_functions();
 
+    // FIXME: HACK, EXPERIMENT!, yay to insecure functions
+    // glxgears only needs this hack : glVertexAttrib4d
+    if (strcmp(symbol, "glVertexAttrib4d") == 0) return (void*)&dummy_func;
+    // supertuxkart needs these hacks : __free_hook, drmSyncobjImportSyncFile, glCompressedMultiTexSubImage2DEXT, glProgramUniform4fvEXT, glProgramUniformMatrix4x3dvEXT, glGenProgramPipelinesEXT
+    if (strcmp(symbol, "__free_hook") == 0) return (void*)&dummy_func;
+    if (strcmp(symbol, "drmSyncobjImportSyncFile") == 0) return (void*)&dummy_func;
+    if (strcmp(symbol, "glCompressedMultiTexSubImage2DEXT") == 0) return (void*)&dummy_func;
+    if (strcmp(symbol, "glProgramUniform4fvEXT") == 0) return (void*)&dummy_func;
+    if (strcmp(symbol, "glProgramUniformMatrix4x3dvEXT") == 0) return (void*)&dummy_func;
+    if (strcmp(symbol, "glGenProgramPipelinesEXT") == 0) return (void*)&dummy_func;
+
     void *result = __dlsym(handle, symbol);
+    printf("[real_dlsym()] Requesting symbol '%s' (handle: %p, result: %p)\n", symbol, handle, result);
+    void *result2 = func_lookup2(symbol);
 
     if (print_dlsym)
         printf("dlsym(%p, %s) = %p\n", handle, symbol, result);
 
-    return result;
+    if (result != NULL) {
+        printf("[real_dlsym()] HOLY SHIT %s IS NOT NULL, WOOOO %p\n", symbol, result);
+        return result;
+    } else {
+        // this receives functions like eglStreamPostD3DTextureANGLE, which is not our job to handle. This is for clarity
+        if (result2 == NULL) {
+            printf("[real_dlsym()] Failed search using our custom lookup method for symbol '%s' (function pointer: %p)\n", symbol, result2);
+            return NULL;
+        }
+
+        printf("[real_dlsym()] Using our custom lookup method for symbol '%s' succeeded (function pointer: %p)\n", symbol, result2);
+        return result2;
+    }
 }
 
